#!/usr/bin/env bash
# .githooks/pre-push
# Quality Gate de Pré-Envio (Local & Custo Zero)
# Impede que código quebrado ou sem testes seja enviado para o GitHub / Cloudflare Pages.

set -e

# Cores para feedback no terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "\n${BLUE}======================================================${NC}"
echo -e "${BLUE}🛡️  Áxis Finance — Quality Gate Local (Pre-Push)${NC}"
echo -e "${BLUE}======================================================${NC}"

# Detecta se o push é direcionado para a branch main
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
TARGET_IS_MAIN=false

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$remote_ref" =~ "refs/heads/main" ]] || [[ "$CURRENT_BRANCH" == "main" ]]; then
    TARGET_IS_MAIN=true
    break
  fi
done

echo -e "🌿 Branch local: ${YELLOW}${CURRENT_BRANCH}${NC}"
if [ "$TARGET_IS_MAIN" = true ]; then
  echo -e "🚀 Destino: ${YELLOW}main (PRODUÇÃO)${NC} — Executando validação de qualidade..."
else
  echo -e "🔍 Destino: ${YELLOW}branch secundária / preview${NC} — Executando validação de qualidade..."
fi

# 1. Typecheck (TypeScript)
echo -e "\n[1/3] 🔍 Verificando Tipagem TypeScript (tsc -b)..."
if ! npm run typecheck; then
  echo -e "\n${RED}❌ FALHA NO TYPECHECK!${NC}"
  echo -e "${RED}Corrija os erros de TypeScript antes de enviar código para o repositório.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✓ Typecheck aprovado!${NC}"

# 2. Linting (ESLint)
echo -e "\n[2/3] 🧹 Verificando Padrões de Código e Regras (eslint)..."
if ! npm run lint; then
  echo -e "\n${RED}❌ FALHA NO LINT!${NC}"
  echo -e "${RED}Corrija os erros de lint ou violações de regras antes de enviar.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✓ Lint aprovado!${NC}"

# 3. Testes Unitários de Domínio & Regras de Negócio
echo -e "\n[3/3] 🧪 Executando Testes de Domínio e Contratos..."
if ! npx vitest run src/domain/; then
  echo -e "\n${RED}❌ FALHA NOS TESTES DE DOMÍNIO!${NC}"
  echo -e "${RED}Regras financeiras de domínio falharam. O envio foi cancelado para proteger o ambiente.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✓ Testes de domínio aprovados!${NC}"

# Se estiver enviando diretamente para a branch main, alerta sobre versão
if [ "$TARGET_IS_MAIN" = true ]; then
  echo -e "\n${YELLOW}💡 Dica de Governança:${NC} Lembre-se de verificar se a versão no package.json foi incrementada (SemVer) para esta release."
fi

echo -e "\n${GREEN}======================================================${NC}"
echo -e "${GREEN}🎉 Quality Gate aprovado com sucesso! Liberando push...${NC}"
echo -e "${GREEN}======================================================\n${NC}"

exit 0
