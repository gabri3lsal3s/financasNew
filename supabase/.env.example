# ============================================================
# SUPABASE EDGE FUNCTIONS — VARIÁVEIS DE AMBIENTE LOCAIS
#
# Para executar as Edge Functions localmente:
# npx supabase functions serve --env-file supabase/.env.local
#
# Em produção, envie via CLI:
# npx supabase secrets set --env-file supabase/.env.production
# ou defina diretamente via `npx supabase secrets set KEY=VALUE`
# ============================================================

# Asaas — API de Pagamentos (v3)
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_TOKEN=

# Suporte ao Cliente — Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Origens permitidas no CORS (opcional em dev, padrão localhost)
ALLOWED_ORIGINS=
