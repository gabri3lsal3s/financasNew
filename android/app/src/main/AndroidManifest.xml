<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="com.guiafinanceiro.app" />
            </intent-filter>

            <!-- Android Share Target para comprovantes Pix, imagens e PDFs bancários -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Launcher Oficial Padrão (Teal - Gratuito) -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher Oficial Pro (Âmbar / Gold - Assinante Pro) -->
        <activity-alias
            android:name=".MainActivityPro"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pro"
            android:roundIcon="@mipmap/ic_launcher_pro_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Serviço de escuta passiva de notificações bancárias -->
        <service
            android:name=".BankNotificationListenerService"
            android:label="Leitor de Notificações Bancárias"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile para Lançar Despesa da Barra de Status (§4.3) -->
        <service
            android:name=".QuickExpenseTileService"
            android:icon="@drawable/ic_tile_expense"
            android:label="@string/shortcut_new_expense"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Google ML Kit: instrui o Google Play Services a disponibilizar o modelo fino de OCR -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Declaração de pacotes bancários para consulta de apps instalados (Android 11+) -->
    <queries>
        <!-- Bancos Tradicionais & Digitais -->
        <package android:name="com.nu.production" />
        <package android:name="br.com.intermedium" />
        <package android:name="com.c6bank.app" />
        <package android:name="br.com.neon" />
        <package android:name="br.com.bradesco.next" />
        <package android:name="com.itau" />
        <package android:name="com.itau.personnalite" />
        <package android:name="com.bradesco" />
        <package android:name="com.santander.app" />
        <package android:name="br.com.santander.way" />
        <package android:name="br.gov.caixa.tem" />
        <package android:name="br.com.gabba.Caixa" />
        <package android:name="br.com.bb.android" />

        <!-- Carteiras Digitais & Pagamentos -->
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.samsung.android.spay" />
        <package android:name="com.samsung.android.raja.spay" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="com.picpay" />
        <package android:name="br.com.uol.ps" />
        <package android:name="br.com.uol.ps.myaccount" />

        <!-- Investimentos, Cripto & Contas Globais -->
        <package android:name="com.btg.pactual.banking" />
        <package android:name="com.btgpactual.investimentos" />
        <package android:name="br.com.xp.carteira" />
        <package android:name="com.xpinc.investments" />
        <package android:name="br.com.rico" />
        <package android:name="br.com.rico.investimentos" />
        <package android:name="com.binance.dev" />
        <package android:name="com.nomadfinancial.app" />
        <package android:name="com.transferwise.android" />

        <!-- Cooperativas, Adquirentes & Outros -->
        <package android:name="br.com.sicoob.net" />
        <package android:name="br.com.sicredi.mobile" />
        <package android:name="br.com.safra.mobile" />
        <package android:name="br.com.stone.ton" />
        <package android:name="co.stone.stone" />
    </queries>
</manifest>
