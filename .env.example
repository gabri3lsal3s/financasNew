# ============================================================
# VARIÁVEIS DE AMBIENTE — referência oficial (FRAG-8)
#
# DESENVOLVIMENTO LOCAL:
# 1. Copie este arquivo: `cp .env.example .env.local`
# 2. Preencha VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY
#
# PRODUÇÃO / VERCEL:
# 1. Acesse: Project Settings > Environment Variables na Vercel
# 2. Adicione VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY
# ============================================================

# --- Supabase · CLIENTE (Vite / Vercel — prefixo VITE_) ---
# Obtenha em: Supabase Dashboard > Project Settings > API
# Em ambiente local: http://127.0.0.1:54321
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase · SERVIDOR / CLI (migrations / edge functions) ---
# Usado apenas fora do bundle do cliente (CLI, CI/CD, edge functions).
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observabilidade · Sentry (F6.3 — opcional) ---
# Preencha apenas em produção (deixa vazio em dev/testes — sem DSN, o SDK
# não entra no bundle). Crie o projeto em https://sentry.io e copie o DSN
# (Settings > Projects > Client Keys).
VITE_SENTRY_DSN=

# --- Cotações · edge function (servidor) ---
# URL base das funções do Supabase; o cron/edge atualiza asset_prices.
SUPABASE_FUNCTION_URL=
QUOTES_CRON_SCHEDULE=0 */6 * * *        # ex.: a cada 6h (UTC)
