# ============================================================
# VARIÁVEIS DE AMBIENTE — referência oficial (FRAG-8)
# Copie para .env.local (dev local) e configure secrets nas
# edge functions / ambiente de deploy. NUNCA commitar .env*.
# ============================================================

# --- Supabase · CLIENTE (Vite — prefixo VITE_) ---
# Painel do Supabase > Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase · SERVIDOR (migrations / edge functions) ---
# Usado apenas fora do bundle do cliente (npm run db, edge functions).
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cotações · edge function (servidor) ---
# URL base das funções do Supabase; o cron/edge atualiza asset_prices.
SUPABASE_FUNCTION_URL=
QUOTES_CRON_SCHEDULE=0 */6 * * *        # ex.: a cada 6h (UTC)

# --- Cloudflare R2 · storage (servidor — src/services/storage) ---
# A UI nunca recebe estas chaves: só presigned URLs do endpoint próprio.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
