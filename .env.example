# ============================================================
# VARIÁVEIS DE AMBIENTE — referência oficial (FRAG-8)
#
# DESENVOLVIMENTO LOCAL:
# 1. Copie este arquivo: `cp .env.example .env.local`
# 2. Preencha VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY
#
# PRODUÇÃO / CLOUDFLARE PAGES:
# 1. Acesse: Settings > Environment Variables no Cloudflare Pages
# 2. Adicione VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY
# ============================================================

# --- Supabase · CLIENTE (Vite / Cloudflare Pages — prefixo VITE_) ---
# Obtenha em: Supabase Dashboard > Project Settings > API
# Em ambiente local: http://127.0.0.1:54321
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase · SERVIDOR / CLI (migrations / edge functions) ---
# Usado apenas fora do bundle do cliente (CLI, CI/CD, edge functions).
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observabilidade · Sentry (F6.3 — opcional) ---
# Preencha apenas em produção (deixa vazio em dev/testes — sem DSN, o SDK
# não entra no bundle). Crie o projeto em https://sentry.io e copie o DSN
VITE_SENTRY_DSN=

# --- SaaS Billing / Provedor de Pagamento ("asaas" ou "stripe") ---
VITE_DEFAULT_BILLING_PROVIDER=asaas

# --- Cotações · edge function (servidor) ---
# URL base das funções do Supabase; o cron/edge atualiza asset_prices.
SUPABASE_FUNCTION_URL=
QUOTES_CRON_SCHEDULE=0 */6 * * *        # ex.: a cada 6h (UTC)

# --- Migração de dados legados (apenas scripts de ETL — fora do bundle) ---
# Usado pelo `scripts/migrate-legacy-data.mjs`; veja docs/DATA_MIGRATION_GUIDE.md.
# Crie um arquivo separado `.env.migration` com:
#   LEGACY_SUPABASE_URL / LEGACY_SUPABASE_SERVICE_ROLE_KEY
#   NEW_SUPABASE_URL / NEW_SUPABASE_SERVICE_ROLE_KEY
#   MIGRATION_START_DATE

# --- Android APK Keystore & Release Signing (NUNCA COMMITAR) ---
# Usado para compilar e assinar APKs em produção.
# A chave criptográfica física deve ser mantida fora do Git (em cofre de senhas).
KEYSTORE_PATH=android/app/release-key.keystore
KEY_ALIAS=guiafinanceiro
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# --- Cloudflare R2 Storage (Distribuição do APK & Egress Grátis) ---
# Obtenha em: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
# Usado pelos scripts locais para envio automatizado de releases (upload:apk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
APK_DOWNLOAD_URL=https://pub-8b490da0649647f0a70d2eff96bd39e0.r2.dev/guia-financeiro-release.apk
